{
  "name": "@memrov2/pentcloud-tool-runtime",
  "version": "0.1.1-dev.4",
  "type": "module",
  "license": "MIT",
  "description": "Cloudflare-native tool-runtime tool pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/Memrov/PentCloud-tools.git",
    "directory": "packages/runtime"
  },
  "engines": {
